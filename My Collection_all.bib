@article{arianoutsou_ecology_2004,
	title = {Ecology, {Conservation} and {Management} of {Mediterranean} {Climate} {Ecosystems}},
	url = {http://www.millpress.nl/shop/index.php?isbn=90-5966-016-1},
	abstract = {Mediterranean-type climates, characterized by a predominantly winter rainfall regime, exist in five regions of the world, namely parts of California, South Africa, Chile, southern Australia and the Mediterranean Basin. These regions share similar climatic conditions and support ecosystems, which have similar structures and dynamics, but each region has a unique history of human habitation and use. Numerous recent accounts provide detailed comparisons of the biology, human use and transformation, and likely impacts of climate and land use changes of the various regions.The global significance of mediterranean-type ecosystems has received special attention in the last few years because of their remarkable species richness proportional to their small area. This diversity has led to their inclusion by international conservation groups as five of the 25 global biodiversity hotspots, defined on the basis of their high levels of plant endemism and high levels of human disturbance. Since most Mediterranean-type ecosystems exist on the coastal fringes and experience a 'pleasant' climate from a human perspective, we can expect ongoing population shifts into these areas, leading to increasing urban development and ecosystem modification. This in turn brings the human population in contact with the multiple forces driving Mediterranean-type ecosystems - particularly summer drought and fire, but it makes them also vulnerable to threats such as those induced by biological invasions. Three decades of MEDECOS meetings have refined and defined a variety of aspects of the ecology of the mediterranean environments. It is the aim of MEDECOS 10TH Conference to tackle the developments of the scientific research in all fields of Mediterranean ecology, to promote interactions among researchers and to bridge the gaps between basic research, conservation goals and management practices.This Book contains more than 150 contributions presented by some of the most prominent and well known scientists in the field. All published contributions were revised and accepted by the Editors supported by a Scientific Committee. This Publication is essential to researchers, students, conservation planners, managers and professors. The printed book contains the abstracts of the articles, while their full version is presented in the enclosed CD-Rom.},
	author = {Arianoutsou, M and duplicateInEN Papanastasis, V P C1 - Af C2 -},
	year = {2004},
	note = {ISBN: 90-5966-016-1},
	keywords = {Ecology, Climatic change, Europe LB - Ar59},
	pages = {1400 ST -- Ecology, Conservation and Management of},
	file = {Attachment:C\:\\Users\\User\\Zotero\\storage\\FUSPXBMB\\Arianoutsou, Papanastasis - 2004.pdf:application/pdf},
}


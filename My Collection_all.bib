@article{kraft_range_2010,
	title = {Range size, taxon age and hotspots of neoendemism in the {California} flora},
	volume = {16},
	issn = {13669516},
	doi = {10.1111/j.1472-4642.2010.00640.x},
	abstract = {Aim Sustaining biological diversity requires the protection of the ecological, evolutionary and landscape-level processes that generate it. Here, we identify areas of high neoendemism in a global diversity hotspot, the California flora, using range size data and molecular-based estimates of taxon age.},

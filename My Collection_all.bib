@article{mitchell_absorption_2014,
	title = {Absorption and peak blood alcohol concentration after drinking beer, wine, or spirits},
	volume = {38},
	issn = {15300277},
	doi = {10.1111/acer.12355},
	abstract = {BACKGROUND: Both the amount and the rate of absorption of ethanol (EtOH) from alcoholic beverages are key determinants of the peak blood alcohol concentration (BAC) and exposure of organs other than gut and liver. Previous studies suggest EtOH is absorbed more rapidly in the fasting than in the postprandial state. The concentration of EtOH and the type of beverage may determine gastric emptying/absorption of EtOH.{\textbackslash}backslashn{\textbackslash}backslashnMETHODS: The pharmacokinetics of EtOH were measured in 15 healthy men after consumption of 0.5 g of EtOH/kg body weight. During this 3-session crossover study, subjects consumed in separate sessions, beer (5.1\% v/v), white wine (12.5\% v/v), or vodka/tonic (20\% v/v) over 20 minutes following an overnight fast. BAC was measured by gas chromatography at multiple points after consumption.{\textbackslash}backslashn{\textbackslash}backslashnRESULTS: Peak BAC (Cmax ) was significantly higher (p {\textbackslash}textless 0.001) after vodka/tonic (77.4 ± 17.0 mg/dl) than after wine (61.7 ± 10.8 mg/dl) or beer (50.3 ± 9.8 mg/dl) and was significantly higher (p {\textbackslash}textless 0.001) after wine than beer. The time to Cmax occurred significantly earlier (p {\textbackslash}textless 0.01) after vodka/tonic (36 ± 10 minutes) compared to wine (54 ± 14 minutes) or beer (62 ± 23 minutes). Six subjects exceeded a Cmax of 80 mg/dl after vodka/tonic, but none exceeded this limit after beer or wine. The area under the concentration-time curve (AUC) was significantly greater after drinking vodka/tonic (p {\textbackslash}textless 0.001) than after wine or beer. Comparison of AUCs indicated the relative bioavailability of EtOH was lower after drinking beer.{\textbackslash}backslashn{\textbackslash}backslashnCONCLUSIONS: Findings indicate that BAC is higher after drinking vodka/tonic than beer or wine after fasting. A binge pattern is significantly more likely to result in BAC above 80 mg/dl after drinking vodka/tonic than beer or wine. Men drinking on an empty stomach should know BAC will vary depending on beverage type and the rate and amount of EtOH.},
	number = {5},
	journal = {Alcoholism: Clinical and Experimental Research},
	author = {Mitchell, Mack C. and Teigen, Erin L. and Ramchandani, Vijay a.},
	year = {2014},
	keywords = {Alcohol absorption, Beverage type differences, Blood alcohol concentrations, Gastric emptying rate, Pharmacokinetics},
	pages = {1200--1204},
	file = {Attachment:C\:\\Users\\User\\Zotero\\storage\\EMMJAPJ6\\Mitchell, Teigen, Ramchandani - 2014.pdf:application/pdf},
}


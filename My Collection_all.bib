	volume = {3},
	issn = {15469735},
	url = {http://kuscholarworks.ku.edu/dspace/bitstream/1808/6567/1/atp.bi.uses{\_}and{\_}requirements.2006.pdf{\%}5Cnhttps://journals.ku.edu/index.php/jbi/article/viewArticle/29},

@article{zeydanli_identification_2012,
	title = {Identification of {Prime} {Butterfly} {Areas} in {Turkey} using systematic conservation planning: {Challenges} and opportunities},
	volume = {150},
	issn = {00063207},
	doi = {10.1016/j.biocon.2012.02.025},
	abstract = {Butterflies are among the most sensitive groups to environmental changes and are prime subjects for many conservation studies. It is essential to conserve butterflies through identifying important sites, namely " Prime Butterfly Areas" (PBAs). Using distribution data of 358 butterfly species, we have identified 65 PBAs in Turkey. Selection of important sites for a single taxon is generally performed using a scoring based system, yet in this study we have adopted Systematic Conservation Planning (SCP) approach. The efficiency of SCP approach, the explicit site prioritization process it provides, and the presence of an established SCP system in Turkey has led to this decision. However, regardless of the system used, to secure effective implementation, conceptual and operational subjects should be considered simultaneously. In majority of the cases, the emphasis is given to the methodological details of conservation assessments and effective tools for implementation are not produced. Therefore, while determining PBAs, rather than following the SCP procedure in a strict manner, we have incorporated elements of other site selection approaches into our study for the adoption and use of the outputs by stakeholders. With this study, we discussed how different stages of the PBA identification process (e.g. setting conservation targets, scoring species, determining the initial and optimal site sets and prioritization) should be handled to ensure implementation. © 2012 Elsevier Ltd.},
	journal = {Biological Conservation},
	author = {Zeydanli, Uĝur S. and Turak, Ayşe S. and Balkiz, Özge and Özüt, Deniz and Ertürk, Alper and Welch, Hilary and Karaçetin, Evrim and Ambarli, Didem and Durmuş, Mustafa and Can Bilgin, C.},
	year = {2012},
	note = {ISBN: 0006-3207},
	keywords = {Turkey, Systematic conservation planning, Butterfly conservation, Prime butterfly areas, Site selection, Stakeholder involvement},
	pages = {86--93},
}

@article{adler_productivity_2011,
	title = {Productivity is a poor predictor of plant species richness},
	volume = {1750},
	issn = {0036-8075},
	url = {http://www.sciencemag.org/content/333/6050/1750.abstract},
	doi = {10.1126/science.1204498},
	abstract = {For over 30 years, the relationship between net primary productivity and species richness has generated intense debate in ecology about the processes regulating local diversity. The original view, still widely accepted, holds that the relationship is hump-shaped, with richness first rising and then declining with increasing productivity. Although recent meta-analyses questioned the generality of hump-shaped patterns, these syntheses have been criticized for failing to account for methodological differences among studies. We addressed such concerns by conducting standardized sampling in 48 herbaceous-dominated plant communities on five continents. We found no clear relationship between productivity and fine-scale (meters{\textbackslash}textlesssup{\textbackslash}textgreater-2{\textbackslash}textless/sup{\textbackslash}textgreater) richness within sites, within regions, or across the globe. Ecologists should focus on novel, mechanistic approaches to understand the multivariate links between productivity and richness.},
	number = {2011},
	author = {Adler, Peter B. and Seabloom, Eric W. and Borer, Elizabeth T. and Hillebrand, Helmut and Hautier, Yann and Hector, Andy and Harpole, W. Stanley and O'Halloran, Lydia R. and Grace, James B. and Anderson, T. Michael and Bakker, Jonathan D. and Biederman, Lori a. and Brown, Cynthia S. and Buckley, Yvonne M. and Calabrese, Laura B. and Chu, Cheng-Jin and Cleland, Elsa E. and Collins, Scott L. and Cottingham, Kathryn L. and Crawley, Michael J. and Damschen, Ellen I. and Davies, Kendi F. and DeCrappeo, Nicole M. and Fay, Philip a. and Firn, Jennifer and Frater, Paul and Gasarch, Eve I. and Gruner, Daniel S. and Hagenah, Nicole and Hille Ris Lambers, Janneke and Humphries, Hope and Jin, Virginia L. and Kay, Adam D and Kirkman, Kevin P. and Klein, Julia a. and Knops, Johannes M. H. and Pierre, La and Kimberley, J. and Lambrinos, John G. and Li, Wei and MacDougall, Andrew S. and McCulley, Rebecca L. and Melbourne, Brett a. and Mitchell, Charles E. and Moore, Joslin L. and Morgan, John W. and Mortensen, Brent and Orrock, John L. and Prober, Suzanne M. and Pyke, David a. and Risch, Anita C. and Schuetz, Martin and Smith, Melinda D. and Stevens, Carly J. and Sullivan, Lauren L. and Wang, Gang and Wragg, Peter D. and Wright, Justin P. and Yang, Louie H.},
	year = {2011},
	note = {ISBN: 0036-8075},
}


@article{legendre_reconstruction_2002,
	title = {Reconstruction of biogeographic and evolutionary networks using reticulograms.},
	volume = {51},
	issn = {1063-5157},
	doi = {10.1080/10635150252899725},
	abstract = {A reticulogram is a general network capable of representing a reticulate evolutionary structure. It is particularly useful for portraying relationships among organisms that may be related in a nonunique way to their common ancestor - relationships that cannot be represented by a dendrogram or a phylogenetic tree. We propose a new method for constructing reticulograms that represent a given distance matrix. Reticulate evolution applies first to phylogenetic problems; it has been found in nature, for example, in the within-species microevolution of eukaryotes and in lateral gene transfer in bacteria. In this paper, we propose a new method for reconstructing reticulation networks and we develop applications of the reticulate evolution model to ecological biogeographic, population microevolutionary, and hybridization problems. The first example considers a spatially constrained reticulogram representing the postglacial dispersal of freshwater fishes in the Québec peninsula; the reticulogram provides a better model of postglacial dispersal than does a tree model. The second example depicts the morphological similarities among local populations of muskrats in a river valley in Belgium; adding supplementary branches to a tree depicting the river network leads to a better representation of the morphological distances among local populations of muskrats than does a tree structure. A third example involves hybrids between plants of the genus Aphelandra.},
	number = {2},
	journal = {Systematic biology},
	author = {Legendre, Pierre and Makarenkov, Vladimir},
	year = {2002},
	note = {ISBN: 1063515025},
	pages = {199--216},
	file = {Attachment:C\:\\Users\\User\\Zotero\\storage\\JJFSSVQI\\Legendre, Makarenkov - 2002.pdf:application/pdf},
}

@article{kouli_vegetation_2012,
	title = {Vegetation development and human activities in {Attiki} ({SE} {Greece}) during the last 5,000 years},
	volume = {21},
	issn = {09396314},
	doi = {10.1007/s00334-011-0336-9},
	abstract = {Pollen assemblages recovered from a 5 m sediment core from the Vravron{\textbackslash}backslashncoastal marsh suggest a close correlation between vegetation development{\textbackslash}backslashnand human presence in Attica, and provide the first complete record of{\textbackslash}backslashnmiddle to late Holocene vegetation history. Correlation of pollen with{\textbackslash}backslashnarchaeological data attempts to decode the man-environment relations of{\textbackslash}backslashnthe past, within the context of the known climatic variability of the{\textbackslash}backslashnmid-late Holocene, in the vicinity of ancient Athens, an area of high{\textbackslash}backslashnhistorical significance. The pollen record of Vravron denotes a rather{\textbackslash}backslashnvariable landscape where open Mediterranean evergreen pine woods{\textbackslash}backslashnalternated with maquis shrublands and grasslands, where human activities{\textbackslash}backslashnand climate have left their imprints on vegetation. During the last{\textbackslash}backslashn5,000 years agricultural practices displayed several variations: cereal{\textbackslash}backslashncultivation appears more intense during the Bronze Age, especially in{\textbackslash}backslashnthe Mycenaean, while a spread of Olea is observed during Geometric to{\textbackslash}backslashnClassical times. The gradual abandonment of Olea cultivation evidenced{\textbackslash}backslashnin our pollen diagram came as a result of the displacement of human{\textbackslash}backslashnactivities in the interior of Mesogaia in Hellenistic and Roman times.{\textbackslash}backslashnOlea and cereal cultivation intensification is observed again during the{\textbackslash}backslashnMesobyzantine period. In the upper part of the core evidence of intense{\textbackslash}backslashnsoil erosion and expansion of Vravron wetland was recorded, coinciding{\textbackslash}backslashnwith the Little Ice Age climatic event and the introduction of Arvanites{\textbackslash}backslashnpopulations in the area.},
	journal = {Vegetation History and Archaeobotany},
	author = {Kouli, Katerina},
	year = {2012},
	note = {ISBN: 0939-6314},
	keywords = {Holocene, Human impact, Vegetation history, Greece, Pollen analysis},
	pages = {267--278},
	file = {Attachment:C\:\\Users\\User\\Zotero\\storage\\VI7RUAHV\\Kouli - 2012.pdf:application/pdf},

@article{spanou_establishing_2007,
	title = {Establishing a bio-monitoring program of plant species and habitats of the {Mesogaia} area ({Athens}, {Greece}): baseline survey results},
	volume = {8},
	abstract = {Ever-increasing human activities in the Mesogaia area (prefecture of{\textbackslash}backslashnAttiki, Greece) have caused severe environmental disturbances and{\textbackslash}backslashnalteration of the area's natural ecosystems. The construction and{\textbackslash}backslashnoperation of the new Athens International Airport “Eleftherios{\textbackslash}backslashnVenizelos\{”\} in the area is expected to amplify these disturbances{\textbackslash}backslashndirectly or indirectly. Bio-monitoring of the remaining natural habitat{\textbackslash}backslashntypes is of high importance; therefore, a research project was{\textbackslash}backslashnestablished in order to monitor any impacts induced by the construction{\textbackslash}backslashnand operation of the new International Airport and the prospective{\textbackslash}backslashndevelopment of the surrounding area. A detailed survey of the flora and{\textbackslash}backslashnvegetation of the area and vegetation mapping enabled the authors to{\textbackslash}backslashnidentify and record the habitat types, plant communities and the area's{\textbackslash}backslashnecosystem dynamics, as well as to evaluate anticipated environmental{\textbackslash}backslashnimpacts. Subsequently, a number of plant taxa connected with{\textbackslash}backslashnconservation references are presented here, along with several habitat{\textbackslash}backslashntypes considered important for plants and animals.},

@article{sarris_studying_2005,
	title = {Studying {Land} {Use} {Patterns} in {Crete} {Island} , {Greece} , {Through} a {Time} {Sequence} of {Landsat} {Images} and {Mapping} {Vegetation} {Patterns}},
	volume = {1},
	url = {http://www.wseas.us/e-library/conferences/2005venice/papers/508-355.pdf},
	abstract = {The discrete character of the islands of the Mediterranean Sea, in terms of their rough anaglyph and their climatic differentiation creates a number of difficulties in the detection of the changes of land use patterns and vegetation pattern through satellite images. The internal complexity of the terrain and the land surface provide obstacles in the clear discrimination of land uses and habitat types. The spatial coherence of the land uses is very helpful for a more complete description of the spectral properties of the satellite images contributing significantly to the detection of the possible coexistence of classes. Apart of the linear methods, differential topological methods were used to detect the spatial complexity of the land uses, such as the fractal dimensions of the perimeters of the polygons constructed through classification techniques. Object oriented classification was applied for the vegetation classification. The above mentioned techniques were employed for a better understanding of the temporal changes of land use and the production of a vegetation map in the island of Crete.},
	journal = {WSEAS Transactions on Environment and Development},
	author = {Sarris, a. and Maniadakis, M. and Lazaridou, O. and Kalogrias, V. and Bariotakis, M. and Pirintsos, S. a.},
	year = {2005},
	keywords = {Classification, Crete, Land Use, Landsat, Satellite Remote Sensing, Temporal changes},
	pages = {272--279},
	file = {Attachment:C\:\\Users\\User\\Zotero\\storage\\YUTXPAPX\\Sarris et al. - 2005.pdf:application/pdf},
}

@article{dogan_mapping_2011,
	title = {Mapping and analysing the diversity of the genus {Acantholimon} taxa in {Turkey} by geographic information systems ({GIS})},
	volume = {35},
	issn = {1300-008X},
	url = {http://journals.tubitak.gov.tr/botany/issues/bot-11-35-2/bot-35-2-1-0910-193.pdf},
	doi = {10.3906/bot-0910-193},
	abstract = {We describe the spatial distribution of the genus Acantholimon Boiss.{\textbackslash}backslashn(Plumbaginaceae) taxa in Turkey, and assess the role that environmental{\textbackslash}backslashnvariables may be playing on this distribution. We collected a large{\textbackslash}backslashnnumber of specimens from 418 geo-referenced sampling sites between 2000{\textbackslash}backslashnand 2004, and established a point database using geographic information{\textbackslash}backslashnsystems (GIS) software. As a result, we identified and mapped 67 taxa;{\textbackslash}backslashn43 of the determined taxa appear to be endemic. We re-evaluated the{\textbackslash}backslashncurrent conservation status of the taxa at a national level using recent{\textbackslash}backslashnIUCN Red List categories. In addition, we extracted the corresponding{\textbackslash}backslashnenvironmental variables of each determined point from the updated and{\textbackslash}backslashnavailable environmental raster map layers of Turkey and analysed the{\textbackslash}backslashnobtained taxa and environmental data by Hierarchical Clustering and{\textbackslash}backslashnCanonical Correspondence Analysis (CCA). Hierarchical Clustering{\textbackslash}backslashndelineated the subgroups, which have similarities at various levels in{\textbackslash}backslashnrespect to environmental variables. The CCA results indicated that 8{\textbackslash}backslashnenvironmental variables including longitude, distance to sea, maximum{\textbackslash}backslashntemperature, mean temperature, minimum temperature, potential{\textbackslash}backslashnevapotranspiration, elevation, and precipitation are the most effective{\textbackslash}backslashnin explaining the spatial distribution of the 18 Acantholimon taxa in{\textbackslash}backslashnTurkey.},
	journal = {Turkish Journal of łdots},
	author = {Doğan, Hm and Doğan, M},
	year = {2011},
	keywords = {biodiversity, ecology, mapping, anatolia, spatial analysis, gis, iucn, özet, boiss, acantholimon, bu çalışmada türkiye acantholimon, cbs, cinsi, coğrafi bilgi sistemleri, ile haritalanması ve analizi, plumbaginaceae, taksonlarının uzaysal dağılımı tanımlandı, türkiye acantholimon cinsi taksonlarının},
	pages = {91--110},
	file = {Attachment:C\:\\Users\\User\\Zotero\\storage\\MT3DD5DU\\Doğan, Doğan - 2011.pdf:application/pdf},
}

@article{wang_utility_2008,
	title = {The utility of {NBS} profiling for plant systematics: {A} first study in tuber-bearing {Solanum} species},
	volume = {276},
	issn = {03782697},
	doi = {10.1007/s00606-008-0087-y},
	abstract = {Systematic relationships are important criteria for researchers and breeders to select materials. We evaluated a novel molecular technique, nucleotide binding site (NBS) profiling, for its potential in phylogeny reconstruction. NBS profiling produces multiple markers in resistance genes and their analogs (RGAs). Potato (Solanum tuberosum L.) is a crop with a large secondary genepool, which contains many important traits that can be exploited in breeding programs. In this study we used a set of over 100 genebank accessions, representing 49 tuber-bearing wild and cultivated Solanum species. NBS profiling was compared to amplified fragment length polymorphism (AFLP). Cladistic and phenetic analyses showed that the two techniques had similar resolving power and delivered trees with a similar topology. However, the different statistical tests used to demonstrate congruency of the trees were inconclusive. Visual inspection of the trees showed that, especially at the lower level, many accessions grouped together in the same way in both trees; at the higher level, when looking at the more basal nodes, only a few groups were well supported. Again this was similar for both techniques. The observation that higher level groups were poorly supported might be due to the nature of the material and the way the species evolved. The similarity of the NBS and AFLP results indicate that the role of disease resistance in speciation is limited.},
	journal = {Plant Systematics and Evolution},
	author = {Wang, Miqia and Van Den Berg, Ronald and Van Der Linden, Gerard and Vosman, Ben},
	year = {2008},
	note = {ISBN: 0378-2697},
	keywords = {Speciation, Phylogeny, NBS profiling, Potato, Resistance gene analogs, Solanum},
	pages = {137--148},
	file = {Attachment:C\:\\Users\\User\\Zotero\\storage\\BRGAM5AE\\Wang et al. - 2008.pdf:application/pdf},
}


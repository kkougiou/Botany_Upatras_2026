@article{rinnan_climate-niche_2019,
	title = {Climate-niche factor analysis: a spatial approach to quantifying species vulnerability to climate change},
	issn = {16000587},
	doi = {10.1111/ecog.03937},
	abstract = {Climate change vulnerability assessments are an important tool for understanding the threat that climate change poses to species and populations, but do not generally yield insight into the spatial variation in vulnerability throughout a species' habitat. We demonstrate how to adapt the method of ecological-niche factor analysis (ENFA) to objectively quantify aspects of species sensitivity to climate change. We then expand ENFA to quantify aspects of exposure and vulnerability to climate change as well, using future projections of global climate models. This approach provides spatially-explicit insight into geographic patterns of vulnerability, relies only on readily-available spatial data, is suitable for a wide range of species and habitats, and invites comparison between different species. We apply our methods to a case study of two species of montane mammals, the American pika Ochotona princeps and the yellow-bellied marmot Marmota flaviventris.},
	journal = {Ecography},
	author = {Rinnan, D. Scott and Lawler, Joshua},
	year = {2019},
	keywords = {climate change, vulnerability assessment, ecological-niche factor analysis (ENFA), exposure, Marmota flaviventris, Ochotona princeps, sensitivity, vulnerability},
}

@article{hirzel_ecological-niche_2002,
	title = {Ecological-{Niche} {Factor} {Analysis}: {How} to {Compute} {Habitat}-{Suitability} {Maps} without {Absence} {Data}?},
	issn = {00129658},
	doi = {10.2307/3071784},
	abstract = {Presentan una nueva forma de realizar un análisis de sobreposición pero teniendo en cuenta la cantidad de citas que hay por clase de variable independiente. El análisis se llama ENFA: Ecological-niche factor analysis. Para ello calculan en primer lugar la MARGINALIDAD (que es la distancia que hay entre los valores de la variable y la muestra de los valores de esta variable asociados a la presencia de la especie) y la ESPECIALIDAD (que es el número de veces que es mayor la varianza de la variable con respecto a la muestra). A partir de estas de la matriz de covarianza de las variables y de estas dos medidas calculan autovectores, que representan nuevas variables que resumen la variabilidad de las originales (de forma similar a un análisis de componentes principales). El primer vector corresponde a la marginalidad y el resto a la especialidad. Estas nuevas variables son los ECOLOGICAL FACTORS. A partir de estos EF se puede calcular el HABITAT SUITABILITY INDEX, que cuenta el número de citas totales y el número de citas en una clase dada de un EF dado. Cada EF se divide en varias clases de forma que la mediana queda entre dos clases. La representación gráfica del HSI es el HABITAT SUITABILITY MAP, es decir, el modelo potencial.Ver resumen también en el diario V de tesis (fecha 15/03/04).Ejemplifican el método con el cálculo de la distribución potencial de Capra ibex en Suiza.},
	journal = {Ecology},
	author = {Hirzel, A. H. and Hausser, J. and Chessel, D. and Perrin, N.},
	year = {2002},
}


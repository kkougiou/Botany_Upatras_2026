	abstract = {Dietary guidelines from a variety of sources are generally congruent that an adequate dietary protein intake for persons over the age of 19 is between 0·8-0·9 g protein/kg body weight/d. According to the US/Canadian Dietary Reference Intakes, the RDA for protein of 0·8 g protein/kg/d is "...the average daily intake level that is sufficient to meet the nutrient requirement of nearly all [∼98 \%]łdots healthy individuals..." The panel also states that "...no additional dietary protein is suggested for healthy adults undertaking resistance or endurance exercise." These recommendations are in contrast to recommendations from the US and Canadian Dietetic Association: "Protein recommendations for endurance and strength trained athletes range from 1·2 to 1·7 g/kg/d." The disparity between those setting dietary protein requirements and those who might be considered to be making practical recommendations for athletes is substantial. This may reflect a situation where an adaptive advantage of protein intakes higher than recommended protein requirements exists. That population protein requirements are still based on nitrogen balance may also be a point of contention since achieving balanced nitrogen intake and excretion likely means little to an athlete who has the primary goal of exercise performance. The goal of the present review is to critically analyse evidence from both acute and chronic dietary protein-based studies in which athletic performance, or correlates thereof, have been measured. An attempt will be made to distinguish between protein requirements set by data from nitrogen balance studies, and a potential adaptive 'advantage' for athletes of dietary protein in excess of the RDA.},
	journal = {British Journal of Nutrition},
	author = {Phillips, Stuart M.},
	year = {2012},
	note = {ISBN: 1111111111},
	keywords = {1, 2, adults, amino acid, an almost global consensus, and those issuing, carbohydrate, conflict between those who, dietary protein requirements for, establish, guidelines for athletes, is that, leucine, nitrogen balance, performance, there is an apparent},
	pages = {S158--S167},
	file = {Attachment:C\:\\Users\\User\\Zotero\\storage\\IKKH6JNR\\Phillips - 2012.pdf:application/pdf},
}

@article{tsiftsis_pseudorchis_2011,
	title = {Pseudorchis albida : an enigmatic orchid of the {Greek} flora},
	volume = {43},
	abstract = {In this study we present the first confirmed record of Pseudorchis albida in Greece. Data concerning the distribution, the habitat preferences, as well as its population size were recorded, and these information have been used to determine its threat category. In total, P. albida has been found in three sites having a small number of individuals each. It inhabits the upper zone of the Pinus heldreichii forest of Mt Orvilos. According to the IUCN criteria, and based on the small distribution area and the small number of individuals, P. albida has been classified as Critically Endangered (CR). However, potential threats, and conservation measures against them are provided, which may ensure the long term persistence of this orchid.},
	number = {4},
	journal = {Journal Europaischer Orchideen},
	author = {Tsiftsis, Spyros and Antonopoulos, Zissis},
	year = {2011},
	keywords = {conservation, flora of greece, orchidaceae, mt orvilos, pseudorchis albida},

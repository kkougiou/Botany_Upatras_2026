@article{matsui_multiple_2005,
	title = {Multiple invasions of the {Ryukyu} {Archipelago} by {Oriental} frogs of the subgenus {Odorrana} with phylogenetic reassessment of the related subgenera of the genus {Rana}},
	volume = {37},
	issn = {10557903},
	doi = {10.1016/j.ympev.2005.04.030},
	abstract = {The genus Rana, notably diversified in Oriental regions from China to Southeast Asia, includes a group of cascade frogs assigned to subgenera Odorrana and Eburana. Among them, R. ishikawae and the R. narina complex represent the northernmost members occurring from Taiwan to the Ryukyu Archipelago of Japan. Relationships of these frogs with the continental members, as well as the history of their invasions to islands, have been unclear. The taxonomic status of Odorrana and related genera varies among authors and no phylogenetic reassessment has been done. Using partial sequences of mitochondrial 12S and 16S rRNA genes, we estimated phylogenetic relationships among 17 species of the section Hylarana including Odorrana and Eburana, and related species from the Ryukyus, Taiwan, China, Thailand, Malaysia, and Indonesia. We estimate that (1) Odorrana is monophyletic and encompasses species of Eburana and R. hosii, which is now placed in Chalcorana, (2) the ancestor of R. ishikawae separated from other Rana in the middle to late Miocene prior to its entry to the Ryukyu Archipelago, (3) the ancestor of the R. narina complex later diversified in continental Asia, and invaded the Ryukyu Archipelago through Taiwan, (4) the R. narina complex attained its current distribution within the Ryukyus through niche segregations, and (5) vicariance of R. hosii between Malay Peninsula and Borneo occurred much later than the divergence events in the R. narina complex. Current subgeneric classification of Rana, at least of Southeast Asian members, requires full reassessment in the light of phylogenetic relationships. ?? 2005 Elsevier Inc. All rights reserved.},
	journal = {Molecular Phylogenetics and Evolution},
	author = {Matsui, Masafumi and Shimada, Tomohiko and Ota, Hidetoshi and Tanaka-Ueno, Tomoko},
	year = {2005},
	note = {ISBN: 1055-7903},
	keywords = {Biogeography, Speciation, Phylogeny, Classification, Molecular clock, Odorrana, Oriental cascade frogs, Rana},
	pages = {733--742},
	file = {Attachment:C\:\\Users\\User\\Zotero\\storage\\HJ78WVPW\\Matsui et al. - 2005.pdf:application/pdf},
}


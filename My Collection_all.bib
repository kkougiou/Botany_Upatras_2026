@article{englund_phylogenetic_2009,
	title = {Phylogenetic relationships and generic delimitation in {Inuleae} subtribe {Inulinae} ({Asteraceae}) based on {ITS} and {cpDNA} sequence data},
	volume = {25},
	issn = {07483007},
	doi = {10.1111/j.1096-0031.2009.00256.x},
	abstract = {Phylogenetic relationships in Inuleae subtribe Inulinae (Asteraceae) were investigated. DNA sequence data from three chloroplast regions (ndhF, trnL–F and psbA–trnH) and the nuclear ribosomal internal transcribed spacer (ITS) region were analysed separately and in combination using parsimony and Bayesian inference. A total of 163 ingroup taxa were included, of which 60 were sampled for all four markers. Conflicts between chloroplast and nuclear data were assessed using partitioned Bremer support (PBS). Rather than averaging PBS over several trees from constrained searches, individual trees were considered by evaluating PBS ranges. Criteria to be used in the detection of a significant conflict between data partitions are proposed. Three nodes in the total data tree were found to encompass significant conflict that could result from ancient hybridization. Neither of the large, heterogeneous and widespread genera Inula and Pulicaria is monophyletic. A monophyletic group (‘‘the Inula complex”) that comprises all species of Inula includes also Telekia, Carpesium, Chrysophthalmum, Rhanteriopsis, Amblyocarpum, and Pentanema sensu stricto. Two species of Pentanema were found to be closer to Blumea (including Blumeopsis and Merrittia) and Caesulia. The monophyletic ‘‘Pulicaria complex” includes all taxa with heteromorphic pappus. Within this group, Francoeuria is distinct from Pulicaria and merits recognition as a separate genus.},
	journal = {Cladistics},
	author = {Englund, Markus and Pornpongrungrueng, Pimwadee and Gustafsson, Mats H G and Anderberg, Arne a.},
	year = {2009},
	pages = {319--352},
	file = {Attachment:C\:\\Users\\User\\Zotero\\storage\\KXBLEJ7J\\Englund et al. - 2009.pdf:application/pdf},
}


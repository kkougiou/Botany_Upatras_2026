@article{kallimanis_efficient_2012,
	title = {Efficient biodiversity monitoring: {Which} taxonomic level to study?},
	volume = {15},
	issn = {1470160X},
	url = {http://dx.doi.org/10.1016/j.ecolind.2011.09.024},
	doi = {10.1016/j.ecolind.2011.09.024},
	abstract = {Nowadays that biodiversity monitoring is a legal obligation in many countries, monitoring implementation still lags behind the needs for efficient conservation. This is mainly due to three limiting factors that are rarely available for an exhaustive diversity survey, i.e. time consuming, expensive and demands high level of expertise. We propose an alternative monitoring scheme based on the higher taxon approach. This approach allows rapid tracking of biodiversity changes and the utilization of data collected by non-expert volunteers. Here we show, for the first time, that temporal changes in genera or family richness are strongly correlated to, and have similar spatial pattern characteristics as changes in species richness for the breeding birds in New York State. Changes in genera richness proved more reliable in predicting changes in species richness than changes in family richness. ?? 2011 Elsevier Ltd. All rights reserved.},
	number = {1},
	journal = {Ecological Indicators},
	publisher = {Elsevier Ltd},
	author = {Kallimanis, Athanasios S. and Mazaris, Antonios D. and Tsakanikas, Dimitrios and Dimopoulos, Panayotis and Pantis, John D. and Sgardelis, Stefanos P.},
	year = {2012},
	note = {ISBN: 1470-160X},
	keywords = {Monitoring, Sampling design, Avian biodiversity, Breeding birds, Higher taxon approach, Sampling resolution, Taxonomic sufficiency},
	pages = {100--104},
	file = {Attachment:C\:\\Users\\User\\Zotero\\storage\\5QQKB2KE\\Kallimanis et al. - 2012.pdf:application/pdf},
}


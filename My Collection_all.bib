@article{marmion_evaluation_2009,
	title = {Evaluation of consensus methods in predictive species distribution modelling},
	volume = {15},
	issn = {13669516},
	doi = {10.1111/j.1472-4642.2008.00491.x},
	abstract = {Aim: Spatial modelling techniques are increasingly used in species distribution modelling. However, the implemented techniques differ in their modelling performance, and some consensus methods are needed to reduce the uncertainty of predictions. In this study, we tested the predictive accuracies of five consensus methods, namely Weighted Average (WA), Mean(All), Median(All), Median(PCA), and Best, for 28 threatened plant species. Location: North-eastern Finland, Europe. Methods: The spatial distributions of the plant species were forecasted using eight state-of-the-art single-modelling techniques providing an ensemble of predictions. The probability values of occurrence were then combined using five consensus algorithms. The predictive accuracies of the single-model and consensus methods were assessed by computing the area under the curve (AUC) of the receiver-operating characteristic plot. Results: The mean AUC values varied between 0.697 (classification tree analysis) and 0.813 (random forest) for the single-models, and from 0.757 to 0.850 for the consensus methods. WA and Mean(All) consensus methods provided significantly more robust predictions than all the single-models and the other consensus methods. Main conclusions: Consensus methods based on average function algorithms may increase significantly the accuracy of species distribution forecasts, and thus they show considerable promise for different conservation biological and biogeographical applications. -� 2008 The Authors},
	number = {1},
	journal = {Diversity and Distributions},
	author = {Marmion, Mathieu and Parviainen, Miia and Luoto, Miska and Heikkinen, Risto K. and Thuiller, Wilfried},
	year = {2009},
	note = {ISBN: 199
\_eprint: 9403058v2},
	keywords = {Ensemble, Model selection, Distribution modelling, Machine learning methods, Predictive accuracy, Regression and classification methods},
	pages = {59--69},
}

@article{pereira_gis-based_1993,
	title = {{GIS}-based habitat modeling using logistic multiple regression: a study of the {Mt} {Graham} red squirrel},
	volume = {64},
	issn = {00063207},
	url = {http://linkinghub.elsevier.com/retrieve/pii/000632079390421V},
	doi = {10.1016/0006-3207(93)90421-V},
	abstract = {Les techniques statistiques multivariées sont appliquées pour le développement de modèle d'habitat suitability pour l'écureuil rouge du Mont Graham, une espèce en danger. Une base de données digitalisées et un SIG sont utilisés pour supporter l'analyse et amener des sorties pour 2 modèles de régression logistique multiple. Les modèles tentent de prédire, la variable dichotomique dépendante, la présence de l'écureuil ou l'absence. Les variables indépendantes sont une série de facteurs environnementaux dans le premier modèle, et des coordonnées de localisation dans le second cas, où une surface logique de tendance est développée. Les statistiques Bayésienne sont ensuite utilisées pour intégrer les modèles en résultats combinés. Les pertes potentielles d'habitat résultant du développement d'un observatoire astronomique, sont évaluées en utilisant le modèle environnemental, et sont trouvées représenter 3\% de l'habitat courant disponible.},
	number = {1},
	journal = {Biological Conservation},
	author = {Pereira, Josk M C and Itami, Robert M},
	year = {1993},
	note = {ISBN: 0099-1112},
	pages = {99},
}

@article{morin_contemporary_2008,
	title = {Contemporary perspectives on the niche that can improve models of species range shifts under climate change},
	volume = {4},
	issn = {1744-9561},
	url = {http://rsbl.royalsocietypublishing.org/cgi/doi/10.1098/rsbl.2008.0181},
	doi = {10.1098/rsbl.2008.0181},
	abstract = {Revisión sobre modelos correlativos y modelos mecánicos. Consideran que los correlativos predicen el nicho realizado. Consideran que los factores bióticos y abióticos que influyen en las distribuciones de las especies dependen de la escala. Por tanto, no es demasiado útil distinguir entre Grinnellian y Eltonian niches. Discuten cómo downscale los modelos.Definen alfa-diversity as the number of species in a given locality, beta-diversity the number in a region and gamma-diversity the number at spatial scales embracing many ecological regions. De aqui derivan los nichos alfa, beta y gamma, que dependen de los factores que se expresan a esas escalas. The alfa-niche is relevant at the scale of community assembly and diversity in a single locality, the beta-niche to species affinity for particular habitats in a region and the gamma-niche to range-wide distribution.},
	number = {5},
	journal = {Biology Letters},
	author = {Morin, X. and Lechowicz, M. J},
	year = {2008},
	note = {ISBN: 1744-9561},
	pages = {573--576},
}


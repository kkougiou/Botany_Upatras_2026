@article{garzon-orduna_parsimony_2008,
	title = {Parsimony analysis of endemicity describes but does not explain: {An} illustrated critique},
	volume = {35},
	issn = {03050270},
	doi = {10.1111/j.1365-2699.2007.01842.x},
	abstract = {Aim To demonstrate that parsimony analysis of endemicity (PAE) is not{\textbackslash}backslashnanalogous to a cladistic biogeographical analysis.{\textbackslash}backslashnLocation We used six data sets from previously published studies from around{\textbackslash}backslashnthe world.{\textbackslash}backslashnMethods In order to test the efficiency of PAE in recovering historical{\textbackslash}backslashnrelationships among areas, we performed an empirical comparison of nodes{\textbackslash}backslashnrecovered with PAE, primary Brooks parsimony analysis (BPA), and an eventbased{\textbackslash}backslashnmethod using three models (maximum codivergence, reconciled trees, and{\textbackslash}backslashnthe default model of the treefitter program) for six data sets. We measured the{\textbackslash}backslashnperformance of PAE in recovering historical area relationships by counting the{\textbackslash}backslashnnumber and examining the content of nodes recovered by PAE and by historical{\textbackslash}backslashnmethods. The dispersal/vicariance ratio was calculated to assess the prevalence{\textbackslash}backslashnof dispersal or vicariance in each reconstruction and its relationship to the{\textbackslash}backslashnperformance of PAE.{\textbackslash}backslashnResults Our results show that PAE recovers an average of 17.25\% of historical{\textbackslash}backslashnnodes. PAE and BPA tend to provide similar results; however, in relation to the{\textbackslash}backslashnevent-based models, PAE performance was poor under all the tested scenarios.{\textbackslash}backslashnAlthough in some cases PAE reconstructions are more resolved than historical{\textbackslash}backslashnreconstructions, this does not necessarily mean that PAE produces more{\textbackslash}backslashninformative answers. These additional nodes correspond to unsupported{\textbackslash}backslashnstatements that are based solely on the distributional data of taxa and not on{\textbackslash}backslashntheir phylogenetic history. In other words, these nodes were not found by the{\textbackslash}backslashnhistorical methods, which take phylogenetics into account. The number of{\textbackslash}backslashnhistorical nodes recovered using PAE was in general negatively correlated with the{\textbackslash}backslashndispersal/vicariance ratio.{\textbackslash}backslashnMain conclusions Our results show that PAE is unable to recover historical{\textbackslash}backslashnpatterns and therefore does not fit into the current paradigm of historical{\textbackslash}backslashnbiogeography. These findings raise doubts regarding conclusions derived from{\textbackslash}backslashnbiogeographical studies that interpret PAE trees as area cladograms. We{\textbackslash}backslashnacknowledge that PAE aims to describe but does not explain the current{\textbackslash}backslashndistribution of organisms. It is therefore a useful tool in other biogeographical or{\textbackslash}backslashnecological analyses for exploring the distribution of taxa or for establishing{\textbackslash}backslashnhypotheses of primary homology between areas.{\textbackslash}backslashnKeywords{\textbackslash}backslashnCladistic biogeography, dispersal, event-based methods, historical biogeography,{\textbackslash}backslashnPAE, primary homology, vicariance.},
	journal = {Journal of Biogeography},
	author = {Garzón-Orduña, Ivonne J. and Miranda-Esquivel, Daniel Rafael and Donato, Mariano},
	year = {2008},
	note = {ISBN: 0305-0270},
	keywords = {Dispersal, Historical biogeography, Vicariance, PAE, Cladistic biogeography, Event-based methods, Primary homology},
	pages = {903--913},
}


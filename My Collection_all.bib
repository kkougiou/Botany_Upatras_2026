@article{ros_how_2012,
	title = {How dung beetles respond to a human-modified variegated landscape in {Mexican} cloud forest: {A} study of biodiversity integrating ecological and biogeographical perspectives},
	volume = {18},
	issn = {13669516},
	doi = {10.1111/j.1472-4642.2011.00834.x},
	abstract = {Aim To analyse how the dung beetles (Scarabaeinae) respond to a modified, variegated landscape, taking into account the biogeographical peculiarities of the Mexican Transition Zone. Location This study covers cloud forest (CF) of the Sierra Norte de Puebla mountain range and part of the Sierra Madre Oriental mountain range (Mexico). Methods We applied proportional sampling based on the landscape variegation model with Scarabaeinae as the indicator group, and using two approaches: structural units (vegetation type) and spatial units (windows). We used two measures - richness and Shannon diversity - and applied multiplicative diversity partitioning to obtain independent alpha and beta diversities for the landscape, windows and vegetation types. We grouped species by biogeographical distribution pattern for the biogeographical analysis and by whether they were originally from CF. Results The transformation of CF into secondary forest, pastures and other types of vegetation increases the Scarabaeinae diversity of the landscape, in vegetation types and windows. This increase is the result of species arriving from the tropical lowlands. However, the original dung beetle community of the CF dominates at different scales in the number of species, abundance and biomass. With increasing habitat modification, beta diversity increases in the windows, and species with the Tropical Palaeoamerican distribution pattern increase in abundance in vegetation types and windows. Main conclusions The variegated character of the landscape explains well the distribution and diversity of this dung beetle community. The peculiar characteristics of the Mexican Transition Zone have an effect owing to the overlap of fauna with different biogeographical origins. The conversion of fragmented landscapes to variegated landscapes could be a conservation goal in human-modified mountain landscapes. Sampling proportional to the area of different types of vegetation and the use of windows offer an alternative experimental design in variegated landscapes.},
	journal = {Diversity and Distributions},
	author = {Rös, Matthias and Escobar, Federico and Halffter, Gonzalo},
	year = {2012},
	note = {ISBN: 1366-9516},
	keywords = {Conservation, Biogeographical distribution pattern, Landscape variegation model, Mexican Transition Zone, Scarabaeinae, True diversities},
	pages = {377--389},
}

@article{fattorini_species_2012,
	title = {Species richness and turnover patterns in european tenebrionid beetles},
	volume = {5},
	issn = {1752458X},
	doi = {10.1111/j.1752-4598.2011.00164.x},
	abstract = {. 1. We used a hyperdiverse invertebrate group, tenebrionid beetles, to{\textbackslash}backslashntest competing hypotheses about the factors correlated with the spatial{\textbackslash}backslashnvariation in species richness and composition across Europe. 2. We{\textbackslash}backslashnconsidered the following hypotheses for explaining variation in species{\textbackslash}backslashnrichness, (i) spatial heterogeneity, (ii) environmental energy, and{\textbackslash}backslashn(iii) dispersal limitation and post-glacial recolonisation, and the{\textbackslash}backslashnfollowing hypotheses for variation in species composition, (i) current{\textbackslash}backslashnclimate, (ii) Pleistocene glaciations, and (iii) neutral dynamics. 3. We{\textbackslash}backslashnused inventories of 36 European territories, built from a database{\textbackslash}backslashncontaining the distributions of 1010 species or subspecies. Area,{\textbackslash}backslashnspatial position, and topographical and climatic variables were used as{\textbackslash}backslashnpredictors in regression (richness) and constrained analysis of{\textbackslash}backslashnprincipal coordinates (composition) analyses. 4. The latitudinal{\textbackslash}backslashnrichness gradient found in European tenebrionids was mostly explained by{\textbackslash}backslashnthe joint effect of environmental and spatial variables, supporting the{\textbackslash}backslashnclimate and incomplete recolonisation hypotheses. 5. A parabolic{\textbackslash}backslashnrelationship of endemism with longitude points to the presence of{\textbackslash}backslashncentres of endemism in the Iberian Peninsula and the Balkans. Current{\textbackslash}backslashnclimatic conditions alone were not sufficient to explain spatial{\textbackslash}backslashnturnover patterns of European tenebrionids, which are largely influenced{\textbackslash}backslashnby spatial factors. 6. Both the Pleistocene glaciations and neutral{\textbackslash}backslashnhypotheses were supported, but the fact that turnover is not uniform{\textbackslash}backslashnacross Europe suggests that the historical effects of Pleistocene{\textbackslash}backslashnglaciations had a deeper impact on tenebrionid assemblages than neutral{\textbackslash}backslashndynamics. Thus, variation in species richness seems more directly{\textbackslash}backslashncontrolled by climatic factors, whereas geographical constraints related{\textbackslash}backslashnto dispersal limitation or stochastic colonisation events influenced{\textbackslash}backslashnspecies composition.},
	journal = {Insect Conservation and Diversity},
	author = {Fattorini, Simone and Baselga, Andrés},
	year = {2012},
	keywords = {Endemics, Pleistocene refugia, Latitudinal gradient, Species-area relationship},
	pages = {331--345},
	file = {Attachment:C\:\\Users\\User\\Zotero\\storage\\RLAWLXZW\\Fattorini, Baselga - 2012.pdf:application/pdf},
}


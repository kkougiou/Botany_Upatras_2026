@article{aanen_evolution_2007,
	title = {The evolution of obligate mutualism: if you can't beat 'em, join 'em},
	volume = {22},
	issn = {01695347},
	doi = {10.1016/j.tree.2007.08.007},
	abstract = {Wolbachia is best known as a facultative endosymbiotic parasite, manipulating host reproduction. However, it has also evolved as an obligate mutualist at least twice. In a recent paper, Pannebakker et al. identify a possible mechanism for such a transition from facultative parasitism to obligate mutualism in a parasitic wasp in which Wolbachia are required for producing eggs (oogenesis). Their proposed mechanism suggests that compensatory evolution in the host to counter the harmful effects of Wolbachia is the basis of this evolutionary transition. ?? 2007 Elsevier Ltd. All rights reserved.},

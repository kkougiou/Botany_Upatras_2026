	title = {Interdependence of native bee faunas and floras in changing {Mediterranean} communities},
	abstract = {In a phryganic (East Mediterranean garrigue) system consisting of 133 flowering plant species pollinated by 262 bee species, we found that: Andrenidae tend to visit annuals (tendency is statistically significant) Anthophoridae tend to visit perennials (tendency is statistically significant at p=0.079) Apidae tend to visit perennials, but this tendency is not statistically significant Colletidae prefer perennials (tendency is statistically significant) Halictidae tend to visit annuals, but this tendency is not statistically significant Megachilidae prefer perennials (tendency is statistically significant)},
	booktitle = {The conservation of bees},
	publisher = {Academic Press, London},

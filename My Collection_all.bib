@article{vetaas_north_2014,
	title = {North {Atlantic} {Islands} with native and alien trees: {Are} there differences in diversity and species-area relationships?},
	volume = {25},
	issn = {11009233},
	doi = {10.1111/jvs.12045},
	abstract = {QuestionsAre there differences in species composition and richness{\textbackslash}backslashnbetween islands that were reforested more than 70yr ago with the{\textbackslash}backslashnintroduced Pinus mugo compared with islands supporting the native Pinus{\textbackslash}backslashnsylvestris? Do the results depend on autocorrelation in geographical{\textbackslash}backslashnspace and species ordination space? Species richness is expected to{\textbackslash}backslashnincrease as a function of the size of an island; are the responses to{\textbackslash}backslashnisland size different between P.mugo and P.sylvestris islands. Does the{\textbackslash}backslashnland-use history have an impact on the current species composition and{\textbackslash}backslashnrichness pattern?{\textbackslash}backslashnLocationThe archipelago is in the oceanic section of the Atlantic{\textbackslash}backslashnbioclimatic zone, west Norway. This archipelago was part of the ancient{\textbackslash}backslashnand widespread treeless heathland found along the European west coast.{\textbackslash}backslashnMethodsData on vascular plants were compiled from the forested islands,{\textbackslash}backslashnand their differences in species composition were analysed by{\textbackslash}backslashnordination. The hypotheses were tested by means of t-tests and{\textbackslash}backslashngeneralized linear models, the spatial component was accounted for by{\textbackslash}backslashnmeans of Moran's I and spatial autoregression with the moving average{\textbackslash}backslashnapproach. This was done both in geographical space and species{\textbackslash}backslashnordination space.{\textbackslash}backslashnResultsThere are more vascular plants on the islands with introduced{\textbackslash}backslashnP.mugo than on the islands with native P.sylvestris. The latter have{\textbackslash}backslashnrather homogenous undergrowth dominated by bryophytes. This may explain{\textbackslash}backslashnlower richness on islands with native forest and why island size is not{\textbackslash}backslashncorrelated with species richness on these islands. In contrast, P.mugo{\textbackslash}backslashnis easily wind-felled in autumn storms, which keeps rocky microhabitats{\textbackslash}backslashnexposed to air and new forest habitats are created. Species that are{\textbackslash}backslashnassociated with the previous land-use system (grazing) prevail on{\textbackslash}backslashnislands with introduced pine, and thus contribute to higher plant{\textbackslash}backslashnrichness.{\textbackslash}backslashnConclusionsThe difference in species richness and island species-area{\textbackslash}backslashnrelationship (ISAR) between P.mugo and P.sylvestris islands may relate{\textbackslash}backslashnto the same underpinning causes. Species from the old land-use system{\textbackslash}backslashnhave survived on P.mugo islands, but not in the late-successional forest{\textbackslash}backslashnwith a more closed canopy that has developed on P.sylvestris islands.{\textbackslash}backslashnThus habitat and species richness is higher and increases with area on{\textbackslash}backslashnP.mugo islands but not on P.sylvestris islands.},
	journal = {Journal of Vegetation Science},
	author = {Vetaas, Ole R. and Vikane, Jan H. and Saure, Heidi I. and Vandvik, Vigdis},
	year = {2014},
	note = {ISBN: 1654-1103},
	keywords = {Diversity, Island biogeography, Richness, Autocorrelation, Introduced species, Pine, Spatial Autoregression, Species space},
	pages = {213--225},
	file = {Attachment:C\:\\Users\\User\\Zotero\\storage\\BAWXE2PI\\Vetaas et al. - 2014.pdf:application/pdf},
}

@article{vazacova_importance_2014,
	title = {The importance of species traits for species distribution on {Oceanic} islands},
	volume = {9},
	issn = {19326203},
	doi = {10.1371/journal.pone.0101046},
	abstract = {Understanding species' ability to colonize new habitats is a key knowledge allowing us to predict species' survival in the changing landscapes. However, most studies exploring this topic observe distribution of species in landscapes which are under strong human influence being fragmented only recently and ignore the fact that the species distribution in these landscapes is far from equilibrium. Oceanic islands seem more appropriate systems for studying the relationship between species traits and its distribution as they are fragmented without human contribution and as they remained unchanged for a long evolutionary time. In our study we compared the values of dispersal as well as persistence traits among 18 species pairs from the Canary Islands differing in their distribution within the archipelago. The data were analyzed both with and without phylogenetic correction. The results demonstrate that no dispersal trait alone can explain the distribution of the species in the system. They, however, also suggest that species with better dispersal compared to their close relatives are better colonizers. Similarly, abundance of species in the archipelago seems to be an important predictor of species colonization ability only when comparing closely related species. This implies that analyses including phylogenetic correction may provide different insights than analyses without such a correction and both types of analyses should be combined to understand the importance of various plant traits for species colonization ability.},
	number = {7},
	journal = {PLoS ONE},
	author = {Vazačová, Kristýna and Münzbergová, Zuzana},
	year = {2014},
}


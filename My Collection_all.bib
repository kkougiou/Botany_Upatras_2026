	volume = {283},
	issn = {03782697},
	doi = {10.1007/s00606-009-0230-4},
	abstract = {THe distributions of 77 Arctic-Alpine species in the Balkans are mapped and the centers of their richness and diversity presented. Within the Dinaric Alps these are Mts Vranica, Durmitor, and Prokletije; in the Scardo-Pindhic mountains, Šarplanina–Rudoka–Korab form a continuous chain; in the Rhodope-Rila mountain system there are Mts Vitoša, Rila, and Pirin; while in the Balkan mountain system there are the West and Central part of Stara planina. A comparison of floristic richness and distribution of Arctic-Alpine flora in relation to altitude, geographical location, and geological substrate is made. Correlations between floristic richness and geographical distance of the Balkan mountains from the two main centers of Arctic-Alpine flora in Central Europe are also provided},

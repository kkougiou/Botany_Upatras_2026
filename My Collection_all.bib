@book{castellari_climate_2017,
	title = {Climate change, impacts and vulnerability in {Europe}},
	isbn = {978-92-9213-835-6},
	url = {https://www.eea.europa.eu/publications/climate-change-adaptation-and-disaster},
	abstract = {This report presents about 40 indicators that summarize past trends and projected changes in the climate system as well as past and projected impacts of climate change on environmental systems and society. The system-and sector-specific indicators are complemented by an overview of multi-sectoral climate change vulnerability and risk assessments in Europe and in European macro-regions. Furthermore, the report reviews adaptation policies at the global, European, transnational and national level and makes suggestions for further developing adaptation policies in Europe and the underlying knowledge base.},

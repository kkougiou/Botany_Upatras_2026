@article{camara-leret_new_2020,
	title = {New {Guinea} has the world's richest island flora},
	volume = {584},
	issn = {14764687},
	doi = {10.1038/s41586-020-2549-5},
	abstract = {New Guinea is the world's largest tropical island and has fascinated naturalists for centuries1,2. Home to some of the best-preserved ecosystems on the planet3 and to intact ecological gradients—from mangroves to tropical alpine grasslands—that are unmatched in the Asia-Pacific region4,5, it is a globally recognized centre of biological and cultural diversity6,7. So far, however, there has been no attempt to critically catalogue the entire vascular plant diversity of New Guinea. Here we present the first, to our knowledge, expert-verified checklist of the vascular plants of mainland New Guinea and surrounding islands. Our publicly available checklist includes 13,634 species (68\% endemic), 1,742 genera and 264 families—suggesting that New Guinea is the most floristically diverse island in the world. Expert knowledge is essential for building checklists in the digital era: reliance on online taxonomic resources alone would have inflated species counts by 22\%. Species discovery shows no sign of levelling off, and we discuss steps to accelerate botanical research in the ‘Last Unknown'8.},
	number = {7822},
	journal = {Nature},
	author = {Cámara-Leret, Rodrigo and Frodin, David G. and Adema, Frits and Anderson, Christiane and Appelhans, Marc S. and Argent, George and Arias Guerrero, Susana and Ashton, Peter and Baker, William J. and Barfod, Anders S. and Barrington, David and Borosova, Renata and Bramley, Gemma L.C. and Briggs, Marie and Buerki, Sven and Cahen, Daniel and Callmander, Martin W. and Cheek, Martin and Chen, Cheng Wei and Conn, Barry J. and Coode, Mark J.E. and Darbyshire, Iain and Dawson, Sally and Dransfield, John and Drinkell, Clare and Duyfjes, Brigitta and Ebihara, Atsushi and Ezedin, Zacky and Fu, Long Fei and Gideon, Osia and Girmansyah, Deden and Govaerts, Rafaël and Fortune-Hopkins, Helen and Hassemer, Gustavo and Hay, Alistair and Heatubun, Charlie D. and Hind, D. J.Nicholas and Hoch, Peter and Homot, Peter and Hovenkamp, Peter and Hughes, Mark and Jebb, Matthew and Jennings, Laura and Jimbo, Tiberius and Kessler, Michael and Kiew, Ruth and Knapp, Sandra and Lamei, Penniel and Lehnert, Marcus and Lewis, Gwilym P. and Linder, Hans Peter and Lindsay, Stuart and Low, Yee Wen and Lucas, Eve and Mancera, Jeffrey P. and Monro, Alexandre K. and Moore, Alison and Middleton, David J. and Nagamasu, Hidetoshi and Newman, Mark F. and Nic Lughadha, Eimear and Melo, Pablo H.A. and Ohlsen, Daniel J. and Pannell, Caroline M. and Parris, Barbara and Pearce, Laura and Penneys, Darin S. and Perrie, Leon R. and Petoe, Peter and Poulsen, Axel Dalberg and Prance, Ghillean T. and Quakenbush, J. Peter and Raes, Niels and Rodda, Michele and Rogers, Zachary S. and Schuiteman, André and Schwartsburd, Pedro and Scotland, Robert W. and Simmons, Mark P. and Simpson, David A. and Stevens, Peter and Sundue, Michael and Testo, Weston and Trias-Blasi, Anna and Turner, Ian and Utteridge, Timothy and Walsingham, Lesley and Webber, Bruce L. and Wei, Ran and Weiblen, George D. and Weigend, Maximilian and Weston, Peter and de Wilde, Willem and Wilkie, Peter and Wilmot-Dear, Christine M. and Wilson, Hannah
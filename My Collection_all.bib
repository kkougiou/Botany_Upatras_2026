@article{warren_quantifying_2013,
	title = {Quantifying the benefit of early climate change mitigation in avoiding biodiversity loss},
	volume = {3},
	issn = {1758678X},
	doi = {10.1038/nclimate1887},
	abstract = {Climate change is expected to have significant influences on terrestrial biodiversity at all system levels, including species-level reductions in range size and abundance, especially amongst endemic species. However, little is known about how mitigation of greenhouse gas emissions could reduce biodiversity impacts, particularly amongst common and widespread species. Our global analysis of future climatic range change of common and widespread species shows that without mitigation, 57±6\% of plants and 34±7\% of animals are likely to lose ≥50\% of their present climatic range by the 2080s. With mitigation, however, losses are reduced by 60\% if emissions peak in 2016 or 40\% if emissions peak in 2030. Thus, our analyses indicate that without mitigation, large range contractions can be expected even amongst common and widespread species, amounting to a substantial global reduction in biodiversity and ecosystem services by the end of this century. Prompt and stringent mitigation, on the other hand, could substantially reduce range losses and buy up to four decades for climate change adaptation. © 2013 Macmillan Publishers Limited. All rights reserved.},
	number = {7},
	journal = {Nature Climate Change},
	publisher = {Nature Publishing Group},
	author = {Warren, R. and Vanderwal, J. and Price, J. and Welbergen, J. A. and Atkinson, I. and Ramirez-Villegas, J. and Osborn, T. J. and Jarvis, A. and Shoo, L. P. and Williams, S. E. and Lowe, J.},
	year = {2013},
	pages = {678--682},
	file = {Attachment:C\:\\Users\\User\\Zotero\\storage\\FFIL8GS4\\Warren et al. - 2013(2).pdf:application/pdf},
}

